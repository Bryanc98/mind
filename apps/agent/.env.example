# Copia este archivo a .env y ajusta.  `.env` esta en .gitignore: NUNCA
# se commitea. Un secreto que entra al historial de git ya esta publicado,
# aunque despues borres el archivo.

# --- Obligatoria ---
# Identidad del nodo. Usa el hostname real; es lo que vas a leer en la alerta
# a las 3am, asi que que se entienda sin abrir el inventario.
MIND_NODE_NAME=mi-laptop

# --- Cadencia ---
# Cada cuanto se toma una muestra (ms). Minimo 1000.
# Mas bajo = deteccion mas rapida y mas costo/ruido. 15s es un buen default.
MIND_INTERVAL_MS=15000

# --- Umbrales de salud (%) ---
MIND_CPU_WARN=85
MIND_MEM_WARN=90

# --- Sensibilidad de la maquina de estados ---
# Fallos consecutivos para DEGRADED y para DOWN. DOWN debe ser > DEGRADED.
# Con intervalo de 15s: DEGRADED a los 30s, DOWN al minuto.
MIND_FAILURES_TO_DEGRADE=2
MIND_FAILURES_TO_DOWN=4

# --- Nivel de log: debug | info | warn | error ---
MIND_LOG_LEVEL=info

# --- Modo de operacion ---
# Comentada = modo standalone (el agente se las arregla solo).
# Descomentada = modo hub (solo recolecta y hace push). etapa 2.
# MIND_HUB_URL=https://hub.example.com
