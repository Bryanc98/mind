# Copia este archivo a .env y ajusta.  `.env` esta en .gitignore: NUNCA
# se commitea. Un secreto que entra al historial de git ya esta publicado,
# aunque despues borres el archivo.

# --- Obligatoria ---
# Identidad del nodo. Usa el hostname real; es lo que vas a leer en la alerta
# a las 3am, asi que que se entienda sin abrir el inventario.
MIND_NODE_NAME=mi-laptop

# --- Cadencia ---
# Cada cuanto se toma una muestra (ms). Minimo 1000.
# Mas bajo = deteccion mas rapida y mas costo/ruido. 15s es un buen default.
MIND_INTERVAL_MS=15000

# --- Umbrales de salud (%) ---
MIND_CPU_WARN=85
MIND_MEM_WARN=90

# --- Sensibilidad de la maquina de estados ---
# Fallos consecutivos para DEGRADED y para DOWN. DOWN debe ser > DEGRADED.
# Con intervalo de 15s: DEGRADED a los 30s, DOWN al minuto.
MIND_FAILURES_TO_DEGRADE=2
MIND_FAILURES_TO_DOWN=4

# --- Nivel de log: debug | info | warn | error ---
MIND_LOG_LEVEL=info

# --- Modo de operacion ---
# Comentada = modo standalone (el agente se las arregla solo).
# Descomentada = modo hub (solo recolecta y hace push al Hub).
# MIND_HUB_URL=https://hub.example.com
# Obligatorio en modo hub. Lo emite `mind-hub agent add <nodo>`; es unico por nodo.
# MIND_SERVER_TOKEN=

# Cola en disco para los reportes que no se pudieron entregar al Hub.
# MIND_BUFFER_DIR=./data
# MIND_BUFFER_MAX=5000

# --- Aplicaciones ---
# URLs a sondear: nombre=url separados por comas. Sirve igual para una app en
# contenedor, en IIS o en cualquier servidor web. Sin credenciales en la URL.
# MIND_HTTP_TARGETS=portal=https://portal.example.com/,api=http://127.0.0.1:3000/health
# Una respuesta mas lenta que esto cuenta como fallo (ms).
# MIND_HTTP_SLOW_MS=2000
# Sin respuesta en este tiempo, fallo por timeout (ms). Mayor que SLOW_MS.
# MIND_HTTP_TIMEOUT_MS=5000

# --- Contenedores ---
# Comentada = colector de Docker desactivado.
# Preferible un proxy del socket que solo permita lecturas (tcp://...) a montar
# el socket directamente: acceso al socket equivale a root en el anfitrion.
# MIND_DOCKER_HOST=unix:///var/run/docker.sock
# Vigila solo los contenedores con esta etiqueta. Recomendado: sin filtro, los
# contenedores de un solo uso (migraciones, seeders) que terminan con codigo 0
# aparecerian como caidos.
# MIND_DOCKER_LABEL=mind.monitor=true
