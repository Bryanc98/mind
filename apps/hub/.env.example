# Configuracion del M.I.N.D. Hub. Copia a .env y ajusta; .env no se commitea.

# --- Obligatoria ---
MIND_HUB_DATABASE_URL=postgres://mind:cambiar@localhost:5432/mind
# MIND_HUB_STORE=memory   # sin base de datos, solo para pruebas

# --- Servidor ---
# MIND_HUB_HOST=0.0.0.0
# MIND_HUB_PORT=8080
# MIND_HUB_LOG_LEVEL=info
# Un nodo que calla mas de este numero de intervalos se declara caido.
# MIND_HUB_STALE_FACTOR=3
# MIND_HUB_RATE_LIMIT=600          # reportes por minuto y por token

# --- Diagnostico por IA ---
# none | ollama | gemini. Sin proveedor el Hub funciona igual, sin diagnosticos.
MIND_AI_PROVIDER=none
# Modelo; por defecto qwen2.5:7b en ollama y el Flash vigente en gemini.
# MIND_AI_MODEL=
# MIND_AI_OLLAMA_URL=http://127.0.0.1:11434
# Clave de Google AI Studio (no la suscripcion de la app de Gemini).
# MIND_AI_GEMINI_API_KEY=
# Respaldo si el principal falla, en orden: proveedor[:modelo],...
# Con datos que no pueden salir de la organizacion, dejar solo ollama.
# MIND_AI_FALLBACKS=gemini:gemini-3.1-flash-lite,ollama
# Espera antes de diagnosticar, para agrupar las caidas de una cascada (ms).
# MIND_AI_DELAY_MS=5000
# Un servidor diagnosticado no vuelve a disparar hasta pasado este tiempo (ms).
# MIND_AI_COOLDOWN_MS=600000
# MIND_AI_DAILY_LIMIT=50
# MIND_AI_TIMEOUT_MS=90000
