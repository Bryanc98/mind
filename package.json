{
  "name": "mind",
  "version": "0.0.0",
  "private": true,
  "description": "M.I.N.D. - Monitor Inteligente de Nodos y Despliegues",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec packages/*/test/*.test.js apps/*/test/*.test.js",
    "test:watch": "node --test --watch --test-reporter=spec packages/*/test/*.test.js apps/*/test/*.test.js",
    "test:core": "node --test --test-reporter=spec packages/agent-core/test/*.test.js",
    "test:os": "node --test --test-reporter=spec packages/collectors-os/test/*.test.js",
    "agent": "node apps/agent/src/main.js",
    "test:ia": "node --test --test-reporter=spec apps/hub/test/referencia-ia.test.js"
  },
  "packageManager": "pnpm@12.3.4"
}
